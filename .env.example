SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── DATABASE_URL ──────────────────────────────────────────────────────────────
# SQLite (Windows / quick local dev – no PostgreSQL needed):
DATABASE_URL=sqlite:///db.sqlite3

